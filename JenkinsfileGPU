/*
 * Copyright IBM Corp. 2026
 *
 * Jenkins Pipeline for OpenJCEPlus GPU Acceleration Performance Testing
 *
 * This pipeline runs performance benchmarks comparing GPU-accelerated
 * AES/GCM operations against CPU-only baseline.
 *
 * Requirements:
 * - Jenkins node with NVIDIA GPU
 * - CUDA Toolkit installed
 * - OpenJ9 JVM with CUDA support
 * - Maven 3.6+
 */

pipeline {
    agent {
        label 'gpu-enabled'  // Jenkins node with GPU hardware
    }
    
    parameters {
        choice(
            name: 'BENCHMARK_MODE',
            choices: ['BOTH', 'GPU_ONLY', 'CPU_ONLY'],
            description: 'Which benchmarks to run'
        )
        choice(
            name: 'DATA_SIZES',
            choices: ['ALL', 'SMALL', 'MEDIUM', 'LARGE'],
            description: 'Data sizes to test (SMALL=16-64KB, MEDIUM=256KB-1MB, LARGE=4MB+)'
        )
        string(
            name: 'JMH_ITERATIONS',
            defaultValue: '5',
            description: 'Number of JMH measurement iterations'
        )
        string(
            name: 'JMH_WARMUP',
            defaultValue: '3',
            description: 'Number of JMH warmup iterations'
        )
        booleanParam(
            name: 'GENERATE_REPORT',
            defaultValue: true,
            description: 'Generate HTML performance report'
        )
    }
    
    environment {
        MAVEN_OPTS = '-Xmx4g -XX:+UseG1GC'
        CUDA_VISIBLE_DEVICES = '0'  // Use first GPU
    }
    
    stages {
        stage('Environment Check') {
            steps {
                script {
                    echo "=== Environment Information ==="
                    sh 'java -version'
                    sh 'mvn --version'
                    
                    // Check CUDA availability
                    sh 'nvcc --version || echo "WARNING: nvcc not found"'
                    sh 'nvidia-smi || echo "WARNING: nvidia-smi not found"'
                    
                    // Check GPU devices
                    sh '''
                        if command -v nvidia-smi &> /dev/null; then
                            echo "=== GPU Information ==="
                            nvidia-smi --query-gpu=name,driver_version,memory.total --format=csv
                        fi
                    '''
                }
            }
        }
        
        stage('Build CUDA Kernel') {
            steps {
                script {
                    echo "=== Compiling CUDA Kernel ==="
                    sh './buildCudaKernel.sh'
                    
                    // Verify PTX file was created
                    sh '''
                        if [ ! -f src/main/resources/cuda/aes_gcm_kernel.ptx ]; then
                            echo "ERROR: PTX file not generated"
                            exit 1
                        fi
                        echo "✓ PTX file verified"
                    '''
                }
            }
        }
        
        stage('Build Project') {
            steps {
                script {
                    echo "=== Building OpenJCEPlus ==="
                    sh 'mvn clean install -DskipTests'
                }
            }
        }
        
        stage('Run Unit Tests') {
            steps {
                script {
                    echo "=== Running GPU Unit Tests ==="
                    sh '''
                        mvn test \
                            -Dtest=TestGPUAcceleration \
                            -Dopenjceplus.aes.gcm.gpu.enabled=true \
                            -Dopenjceplus.aes.gcm.gpu.minDataSize=16384 \
                            -Dopenjceplus.aes.gcm.gpu.cpuFallback=true
                    '''
                }
            }
        }
        
        stage('Benchmark: CPU Baseline') {
            when {
                expression { params.BENCHMARK_MODE in ['BOTH', 'CPU_ONLY'] }
            }
            steps {
                script {
                    echo "=== Running CPU Baseline Benchmarks ==="
                    sh """
                        mvn clean install -DskipTests \
                            -Djmh.benchmark.skip=false \
                            -Djmh.benchmark=ibm.jceplus.jmh.AESGCMGPUBenchmark \
                            -Dopenjceplus.aes.gcm.gpu.enabled=false \
                            -Djmh.iterations=${params.JMH_ITERATIONS} \
                            -Djmh.warmup=${params.JMH_WARMUP} \
                            -Djmh.resultFormat=json \
                            -Djmh.resultFile=target/jmh-cpu-results.json
                    """
                }
            }
        }
        
        stage('Benchmark: GPU Accelerated') {
            when {
                expression { params.BENCHMARK_MODE in ['BOTH', 'GPU_ONLY'] }
            }
            steps {
                script {
                    echo "=== Running GPU Accelerated Benchmarks ==="
                    sh """
                        mvn clean install -DskipTests \
                            -Djmh.benchmark.skip=false \
                            -Djmh.benchmark=ibm.jceplus.jmh.AESGCMGPUBenchmark \
                            -Dopenjceplus.aes.gcm.gpu.enabled=true \
                            -Dopenjceplus.aes.gcm.gpu.minDataSize=16384 \
                            -Dopenjceplus.aes.gcm.gpu.cpuFallback=true \
                            -Djmh.iterations=${params.JMH_ITERATIONS} \
                            -Djmh.warmup=${params.JMH_WARMUP} \
                            -Djmh.resultFormat=json \
                            -Djmh.resultFile=target/jmh-gpu-results.json
                    """
                }
            }
        }
        
        stage('Generate Performance Report') {
            when {
                expression { params.GENERATE_REPORT && params.BENCHMARK_MODE == 'BOTH' }
            }
            steps {
                script {
                    echo "=== Generating Performance Report ==="
                    sh '''
                        # Create report directory
                        mkdir -p target/performance-report
                        
                        # Generate comparison report
                        cat > target/performance-report/index.html << 'EOF'
<!DOCTYPE html>
<html>
<head>
    <title>OpenJCEPlus GPU Performance Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        h1 { color: #333; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #4CAF50; color: white; }
        tr:nth-child(even) { background-color: #f2f2f2; }
        .speedup-good { color: green; font-weight: bold; }
        .speedup-bad { color: red; }
        .info { background-color: #e7f3fe; padding: 15px; margin: 20px 0; border-left: 6px solid #2196F3; }
    </style>
</head>
<body>
    <h1>OpenJCEPlus GPU Acceleration Performance Report</h1>
    <div class="info">
        <strong>Build:</strong> ${BUILD_NUMBER}<br>
        <strong>Date:</strong> $(date)<br>
        <strong>Node:</strong> ${NODE_NAME}<br>
        <strong>Iterations:</strong> ${JMH_ITERATIONS} measurement, ${JMH_WARMUP} warmup
    </div>
    
    <h2>Performance Results</h2>
    <p>Results will be parsed from JMH JSON output files.</p>
    <p>CPU Results: <a href="../jmh-cpu-results.json">jmh-cpu-results.json</a></p>
    <p>GPU Results: <a href="../jmh-gpu-results.json">jmh-gpu-results.json</a></p>
    
    <h2>Expected Performance Improvements</h2>
    <table>
        <tr>
            <th>Data Size</th>
            <th>Expected Speedup</th>
            <th>Notes</th>
        </tr>
        <tr>
            <td>16 KB</td>
            <td>1.0x - 1.2x</td>
            <td>Below threshold, may use CPU</td>
        </tr>
        <tr>
            <td>64 KB</td>
            <td>1.5x - 2.0x</td>
            <td>Minimal GPU benefit</td>
        </tr>
        <tr>
            <td>256 KB</td>
            <td class="speedup-good">3.0x - 5.0x</td>
            <td>Good GPU utilization</td>
        </tr>
        <tr>
            <td>1 MB</td>
            <td class="speedup-good">5.0x - 10.0x</td>
            <td>Excellent GPU utilization</td>
        </tr>
        <tr>
            <td>4 MB+</td>
            <td class="speedup-good">10.0x - 20.0x</td>
            <td>Maximum GPU benefit</td>
        </tr>
    </table>
    
    <h2>Configuration</h2>
    <pre>
openjceplus.aes.gcm.gpu.enabled=true
openjceplus.aes.gcm.gpu.minDataSize=16384 (16 KB)
openjceplus.aes.gcm.gpu.minBatchSize=4
openjceplus.aes.gcm.gpu.cpuFallback=true
    </pre>
</body>
</html>
EOF
                    '''
                }
            }
        }
    }
    
    post {
        always {
            script {
                // Archive benchmark results
                archiveArtifacts artifacts: 'target/jmh-*.json', allowEmptyArchive: true
                
                // Archive performance report
                if (params.GENERATE_REPORT) {
                    publishHTML([
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'target/performance-report',
                        reportFiles: 'index.html',
                        reportName: 'GPU Performance Report'
                    ])
                }
                
                // Archive test results
                junit testResults: '**/target/surefire-reports/*.xml', allowEmptyResults: true
            }
        }
        success {
            echo "✓ GPU Performance Testing completed successfully"
        }
        failure {
            echo "✗ GPU Performance Testing failed"
        }
    }
}

