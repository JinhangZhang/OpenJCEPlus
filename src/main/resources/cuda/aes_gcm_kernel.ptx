//     const unsigned char* iv,       // Initialization vector (12 bytes)
//     int ivLength,                  // IV length in bytes
//     const unsigned char* aad,      // Additional authenticated data
//     int aadLength,                 // AAD length in bytes
//     const unsigned char* plaintext,// Plaintext input
//     int plaintextLength,           // Plaintext length in bytes
//     unsigned char* ciphertext,     // Ciphertext output (includes tag)
//     int tagLength                  // GCM tag length (12 or 16 bytes)
// );
//
// __global__ void aes_gcm_decrypt_kernel(
//     const unsigned char* key,      // AES key (16, 24, or 32 bytes)
//     int keyLength,                 // Key length in bytes
